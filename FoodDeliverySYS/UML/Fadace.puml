@startuml
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false

class frmPayment {
    -currentCustomerId : int
    -currentOrderId : int
    +PayOrder(paymentMethodId : int, paymentStrategy : IPaymentStrategy) : void
}

class OrderFacade {
    -orderStore : IOrderStore
    +PlaceOrder(customerId : int, items : List<PizzaCart>, paymentMethodId : int, paymentStrategy : IPaymentStrategy) : int
}

interface IPaymentStrategy {
    +Pay(amount : decimal) : bool
}

interface IOrderStore {
    +SaveOrder(customerId : int, items : List<PizzaCart>, paymentMethodId : int) : int
}

class OracleOrderStore {
    +SaveOrder(customerId : int, items : List<PizzaCart>, paymentMethodId : int) : int
}

frmPayment ..> OrderFacade : calls PlaceOrder
OrderFacade ..> IPaymentStrategy : 1. processes payment
OrderFacade --> IOrderStore : 2. saves if approved
OracleOrderStore ..|> IOrderStore

@enduml