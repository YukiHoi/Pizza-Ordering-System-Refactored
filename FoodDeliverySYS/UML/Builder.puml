@startuml
'https://plantuml.com/class-diagram

title Builder UML class diagram

class PizzaBuilder {
    -pizzaId : int
    -sizeId : int
    -crustId : int
    -quantity : int
    +WithPizzaId(Id : int) : PizzaCartBuilder
    +WithSizeId(Id : int) : PizzaCartBuilder
    +WithCrustId(Id : int) : PizzaCartBuilder
    +WithQuantity(value : int) : PizzaCartBuilder
    +Build() : PizzaCart
}

class PizzaCart {
    +PizzaId : int
    +SizeId : int
    +CrustId : int
    +Quantity : int
    +Price : decimal
}
class frmPlaceOrder{
    +PlaceOrder(cart : List<PizzaCart>, customerId : int) : void
}

class PriceCalculator {
    +{static} CalculatePrice(pizzaPrice : decimal, crustPrice : decimal, sizePrice : decimal, quantity : int) : decimal
}

frmPlaceOrder ..> PizzaBuilder : uses
PizzaBuilder ..> PizzaCart : creates
frmPlaceOrder ..> PriceCalculator : calculates price
frmPlaceOrder --> "0..*" PizzaCart : cart

@enduml