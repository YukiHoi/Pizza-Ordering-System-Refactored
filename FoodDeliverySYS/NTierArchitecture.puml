@startuml
allowmixing
top to bottom direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Presentation Layer" {
    class frmPlaceOrder
    class frmPayment
    class frmDispatchOrder
    class frmCloseDelivery
}

package "Business Layer" {
    class PriceCalculator {
        +{static} CalculatePrice() : decimal
    }

    class PizzaCartBuilder {
        +Build() : PizzaCart
    }

    class OrderFacade {
        +PlaceOrder() : int
    }

    interface IOrderStore {
        +SaveOrder() : int
    }

    class DeliveryService {
        +DispatchOrder() : void
        +CloseDelivery() : void
    }

    interface IDeliveryStore {
        +DispatchOrder() : void
        +CloseDelivery() : void
    }
}

package "Data Access Layer" {
    class OracleOrderStore {
        +SaveOrder() : int
    }

    class OracleDeliveryStore {
        +DispatchOrder() : void
        +CloseDelivery() : void
    }
}

database "Oracle Database" as OracleDB

frmPlaceOrder ..> PriceCalculator : calculates price
frmPlaceOrder ..> PizzaCartBuilder : creates cart items
frmPlaceOrder ..> frmPayment : passes cart

frmPayment ..> OrderFacade : places order
OrderFacade --> IOrderStore : uses
OracleOrderStore ..|> IOrderStore

frmDispatchOrder ..> DeliveryService : dispatches order
frmCloseDelivery ..> DeliveryService : closes delivery
DeliveryService --> IDeliveryStore : uses
OracleDeliveryStore ..|> IDeliveryStore

OracleOrderStore ..> OracleDB : saves checkout
OracleDeliveryStore ..> OracleDB : saves delivery changes

@enduml