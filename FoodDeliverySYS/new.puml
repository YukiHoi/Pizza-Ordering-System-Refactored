@startuml
'https://plantuml.com/class-diagram

title Draft UML class diagram

class frmPlaceOrder {
    - cart : List<PizzaCart>
    + AddToCart() : void
    + Checkout() : void
}

class PizzaCartBuilder {
    + WithPizza(id : int) : PizzaCartBuilder
    + WithSize(id : int) : PizzaCartBuilder
    + WithCrust(id : int) : PizzaCartBuilder
    + WithQuantity(value : int) : PizzaCartBuilder
    + Build() : PizzaCart
}

class PizzaCart {
    + PizzaId : int
    + CrustId : int
    + SizeId : int
    + Quantity : int
    + Price : decimal
}

frmPlaceOrder ..> PizzaCartBuilder : uses
PizzaCartBuilder ..> PizzaCart : creates
frmPlaceOrder "1" --> "0..*" PizzaCart : holds cart items
@enduml